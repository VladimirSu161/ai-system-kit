# Yandex Cloud Search API v2 (Wordstat) — API-ключ сервисного аккаунта
# См. config/README.md для пошаговой инструкции получения ключа

# API-ключ сервисного аккаунта (обязателен)
YANDEX_API_KEY=your_api_key_here

# ID каталога (folder), где создан сервисный аккаунт (обязателен)
YANDEX_FOLDER_ID=your_folder_id_here

# Старый Wordstat API (api.wordstat.yandex.net, OAuth) закрыт с 2026 года — не используется
# YANDEX_WORDSTAT_TOKEN=
